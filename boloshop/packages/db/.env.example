# BoloShop — packages/db
#
# Copy to .env for local development. Never commit a real .env.
# Deployed services inject these directly; DATABASE_URL wins when set.

# Either a single connection string ...
DATABASE_URL=postgres://boloshop:boloshop@localhost:5432/boloshop

# ... or the discrete libpq variables (used only when DATABASE_URL is unset).
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=boloshop
# PGUSER=boloshop
# PGPASSWORD=

# TLS: "disable" for local, "no-verify" for managed Postgres whose CA this
# process does not carry, anything else to require a verified certificate.
# PGSSLMODE=disable

# Pool tuning. Keep max low per pod — Postgres does not like thousands of
# connections, and a Pakistani mobile session is short and bursty.
# PGPOOL_MAX=10
# PGPOOL_IDLE_TIMEOUT_MS=30000
# PGPOOL_CONNECTION_TIMEOUT_MS=5000
# PGAPPNAME=boloshop

# --- Redis ---------------------------------------------------------------

# Shared state: OTP challenges and seller credit balances. Defaults to
# redis://localhost:6379 when unset.
# REDIS_URL=redis://localhost:6379

# Cluster mode: a comma-separated list of seed nodes. When set, REDIS_URL is
# ignored and ioredis discovers the rest of the cluster from these.
# REDIS_CLUSTER_NODES=10.0.0.1:6379,10.0.0.2:6379,10.0.0.3:6379

# Namespaces every key, so one Redis can host more than one environment
# without a staging OTP verifying a production login.
# REDIS_KEY_PREFIX=

# REDIS_CONNECT_TIMEOUT_MS=5000
# REDIS_COMMAND_TIMEOUT_MS=3000
# REDIS_MAX_RETRIES_PER_REQUEST=2
