# BoloShop — services/order-service
#
# Copy to .env for local development, or export these directly.
# The service reads the environment; it does not load a .env file itself.

PORT=4002

# PostgreSQL connection. REQUIRED — the process refuses to start without it,
# and pings the database before binding the port.
DATABASE_URL=postgres://boloshop:boloshop@localhost:5432/boloshop?sslmode=disable

# --- optional ---------------------------------------------------------------

# Connection pool ceiling per pod. Postgres does not enjoy thousands of
# connections and an order request is short.
# PGPOOL_MAX=10

# How long a team purchase stays joinable. Pinduoduo-style group buys live or
# die on urgency, hence 24 hours.
# TEAM_BUY_WINDOW_HOURS=24

# Prefix for the shareable team purchase link.
# TEAM_BUY_BASE_URL=https://boloshop.pk/team

# The WhatsApp confirmation message. Placeholders: {{store}}, {{order_id}},
# {{order_short_id}}, {{amount}}, {{commission}}, {{status}}.
# WHATSAPP_TEMPLATE=Assalam-o-Alaikum {{store}}! I have placed order {{order_short_id}} on BoloShop for {{amount}}. Please confirm and share the delivery time. Shukriya!
