# BoloShop — services/media-service
#
# Copy to .env for local development. Never commit a real .env.

PORT=4001

# Where uploads and rendered MP4s live. `incoming/` is scratch and is cleared
# on every boot; `renders/` holds the finished videos until the sweeper's TTL
# takes them.
MEDIA_STORAGE_PATH=./uploads

# PostgreSQL connection, read by @boloshop/db. Used to confirm the seller
# exists before a render is booked against their credits.
DATABASE_URL=postgres://boloshop:boloshop@localhost:5432/boloshop

# Redis, read by @boloshop/db. Credit balances live here so a seller with one
# credit cannot start two renders by hitting two pods at once.
REDIS_URL=redis://localhost:6379

# --- Disk sweeper -----------------------------------------------------------

# Nothing else removes from renders/, so without this the volume fills weeks
# after launch. A pass runs at startup and then on this interval; 0 switches
# the sweeper off entirely.
# MEDIA_SWEEP_INTERVAL_MINUTES=15

# How long a finished MP4 is kept. A seller fetches a promo in the minutes
# after it renders, and the in-memory job record naming it is evicted after an
# hour, so a day is already generous. 0 keeps renders forever.
# MEDIA_RENDER_TTL_MINUTES=1440

# How long leftover uploads and per-render scratch are kept. Both TTLs are
# floored at twice RENDER_TIMEOUT_MS whatever is set here, because a work
# directory's mtime stops moving while FFmpeg encodes.
# MEDIA_SCRATCH_TTL_MINUTES=60

# Delete the oldest renders once renders/ exceeds this many megabytes. 0 (the
# default) means no cap: throwing away a render a seller spent a credit on
# because the disk is busy is a decision to make deliberately. Set it where the
# volume is small and known.
# MEDIA_MAX_RENDER_MB=0

# --- FFmpeg -----------------------------------------------------------------

# Resolved on PATH by default. Point these at absolute paths on a host where
# FFmpeg is installed somewhere unusual (a static build, a Docker layer).
# Without a working binary the service still starts: /health reports it and
# render requests return 503.
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe

# TrueType font for the text overlays. Auto-detected from the usual system
# locations (DejaVu, Liberation, Noto); set this if none of them are present.
# A path that does not exist is treated as no font at all.
# FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf

# RENDER_TIMEOUT_MS=180000
# FFMPEG_PROBE_CACHE_MS=30000

# --- Output -----------------------------------------------------------------

# x264 quality (lower is better and bigger) and speed/size trade-off.
# VIDEO_CRF=23
# VIDEO_PRESET=veryfast

# Prefix for returned video URLs. Leave empty to return site-relative paths;
# set it to the CDN origin in production.
# PUBLIC_BASE_URL=https://cdn.boloshop.pk

# --- Uploads & credits ------------------------------------------------------

# MAX_IMAGE_BYTES=12582912

# What a seller starts with the first time Redis is asked about them. Seeded
# once per seller; a top-up writes the balance directly.
# VIDEO_CREDITS_STARTING_BALANCE=5
# VIDEO_CREDIT_COST_PER_RENDER=1

# --- Misc -------------------------------------------------------------------

# NODE_ENV=development
# CORS_ORIGINS=https://boloshop.pk
# PGSSLMODE=disable

# --- Redis ---------------------------------------------------------------

# Cluster mode: a comma-separated list of seed nodes. When set, REDIS_URL is
# ignored and ioredis discovers the rest of the cluster from these.
# REDIS_CLUSTER_NODES=10.0.0.1:6379,10.0.0.2:6379,10.0.0.3:6379

# Namespaces every key, so one Redis can host more than one environment
# without a staging OTP verifying a production login.
# REDIS_KEY_PREFIX=

# REDIS_CONNECT_TIMEOUT_MS=5000
# REDIS_COMMAND_TIMEOUT_MS=3000
# REDIS_MAX_RETRIES_PER_REQUEST=2
