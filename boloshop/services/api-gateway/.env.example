# BoloShop — services/api-gateway
#
# Copy to .env for local development. Never commit a real .env.

# HTTP port the gateway binds.
PORT=4000

# Secret used to sign and verify JWTs. REQUIRED — the process refuses to start
# without it. Generate one with: openssl rand -base64 48
JWT_SECRET=

# PostgreSQL connection, read by @boloshop/db.
DATABASE_URL=postgres://boloshop:boloshop@localhost:5432/boloshop

# --- optional ---------------------------------------------------------------

# NODE_ENV=development
# Outside production, POST /auth/request-otp returns the code as `dev_otp`.

# Comma-separated CORS allowlist. Empty reflects the request origin, which is
# fine locally; name your origins in production. Native Flutter clients send no
# Origin header and are unaffected.
# CORS_ORIGINS=https://boloshop.pk,https://seller.boloshop.pk

# JWT lifetime in seconds (default 30 days — mobile users on patchy data).
# JWT_EXPIRES_IN_SECONDS=2592000

# OTP behaviour.
# OTP_TTL_SECONDS=300
# OTP_MAX_ATTEMPTS=5
# OTP_RESEND_COOLDOWN_SECONDS=60

# Request body cap.
# JSON_BODY_LIMIT=64kb

# TLS to PostgreSQL: disable | no-verify | (anything else verifies the cert).
# PGSSLMODE=disable
