# BoloShop — docker compose environment.
#
#   cp .env.docker.example .env && docker compose up --build
#
# Compose reads .env from this directory. It is gitignored: never commit a
# filled-in copy.

# --- required ---------------------------------------------------------------

# Signs and verifies session JWTs. Compose refuses to start without it.
#   openssl rand -base64 48
JWT_SECRET=

# --- Postgres ---------------------------------------------------------------
# Local container credentials. Use your provider's values for staging.

POSTGRES_DB=boloshop
POSTGRES_USER=boloshop
POSTGRES_PASSWORD=boloshop
POSTGRES_PORT=5432

# --- Redis ------------------------------------------------------------------

REDIS_PORT=6379

# --- Published host ports ---------------------------------------------------
# Change these if something already owns 4000-4002 on your machine; the
# services always talk to each other on the container ports.

API_GATEWAY_PORT=4000
MEDIA_SERVICE_PORT=4001
ORDER_SERVICE_PORT=4002

# --- optional ---------------------------------------------------------------

# NODE_ENV=production
# Tag applied to the images compose builds.
# IMAGE_TAG=local
# Comma-separated CORS allowlist. Empty reflects the request origin.
# CORS_ORIGINS=https://boloshop.pk
# Origin prefixed to rendered video URLs.
# PUBLIC_BASE_URL=https://cdn.boloshop.pk
# TEAM_BUY_WINDOW_HOURS=24
# TEAM_BUY_BASE_URL=https://boloshop.pk/team
