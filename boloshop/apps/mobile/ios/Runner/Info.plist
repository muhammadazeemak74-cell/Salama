<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Boloshop</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>boloshop</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Voice search ("Bolo"). iOS terminates the app outright if the
	     microphone is requested with no purpose string, and App Review rejects
	     a build whose string does not say what the data is used for. Written
	     for the person reading the prompt, not for the reviewer. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>BoloShop uses your microphone only while you hold the Bolo button, so you can search for products by speaking instead of typing.</string>
	<!-- Paired with the microphone: speech is transcribed to turn what you said
	     into search filters. -->
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>BoloShop turns what you say into search filters, so you can find products in your own words.</string>
	<!-- The buy buttons hand the order to the seller over WhatsApp. Without
	     this, canLaunchUrl reports WhatsApp as unavailable on a device that
	     has it installed, and the app falls back for no reason. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>https</string>
		<string>whatsapp</string>
	</array>
	<!-- Answers App Store Connect's export-compliance question once, here,
	     instead of on every single upload. False is correct: the app uses only
	     HTTPS, which is exempt. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<!-- Portrait only, matching the SystemChrome lock in main.dart. A
	     vertical video feed has no landscape story, and leaving the landscape
	     orientations declared here means iOS sizes the launch storyboard for
	     an orientation the app immediately refuses. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
